@model TestTgChatBot.Dao.Models.Test

@{
    ViewData["Title"] = "Печать QR-кодов";
}

<div class="card">
    <div class="card-header">
        Generation of QR codes for test: @Model.Name
    </div>
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label for="count" class="form-label">Количество кодов (ссылок)</label>
                <input type="number" id="count" name="count" class="form-control" value="10" min="1" max="100" />
                <div class="form-text">Каждый код уникален и позволяет пройти тест один раз.</div>
            </div>
            
            <button type="submit" class="btn btn-primary">Сгенерировать и открыть печать</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
