@model TestTgChatBot.App.Areas.Admin.ViewModels.QuestionEditViewModel

<div class="card mb-3 question">
  <div class="card-body">
    <!-- индексы и Id вопроса -->
    <input type="hidden" name="Questions.Index" value="@Model.LocalId"/>
    <input type="hidden" name="Questions[@Model.LocalId].Id" value="@Model.Id"/>

    @if (Model.Id == 0)
    {
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-3">Вопрос @(Model.LocalId + 1)</h5>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeBlock(this, '.question')">Удалить
          вопрос
        </button>
      </div>
    }

    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label">Текст вопроса</label>
        <input class="form-control" name="Questions[@Model.LocalId].Text" value="@Model.Text"/>
      </div>
      <div class="col-md-4">
        <label class="form-label">Вес</label>
        <input class="form-control" type="number" min="1" step="1" name="Questions[@Model.LocalId].Weight"
               value="@Model.Weight"/>
      </div>
    </div>

    <div class="mt-3">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <strong>Варианты</strong>

        @if (Model.Id == 0)
        {
          <button type="button" class="btn btn-outline-primary btn-sm" onclick="addOption(this, @Model.LocalId)">
            Добавить вариант
          </button>
        }
      </div>

      <div class="options">
        @for (var j = 0; j < Model.Options.Count; j++)
        {
          <div class="row g-2 option mb-2">
            <!-- индексы и Id варианта -->
            <input type="hidden" name="Questions[@Model.LocalId].Options.Index" value="@j"/>
            <input type="hidden" name="Questions[@Model.LocalId].Options[@j].Id" value="@Model.Options[j].Id"/>

            <div class="col-md-9">
              <input class="form-control" name="Questions[@Model.LocalId].Options[@j].Text"
                     value="@Model.Options[j].Text"/>
            </div>
            <div class="col-md-2 form-check d-flex align-items-center">

              <input asp-for="@Model.Options[j].IsCorrect" name="Questions[@Model.LocalId].Options[@j].IsCorrect"
                     class="form-check-input"/>
              <label class="form-check-label ms-2">Правильный</label>
            </div>

            @if (Model.Id == 0)
            {
              <div class="col-md-1 d-flex align-items-center justify-content-end">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="removeBlock(this, '.option')">
                  ✕
                </button>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </div>
</div>
