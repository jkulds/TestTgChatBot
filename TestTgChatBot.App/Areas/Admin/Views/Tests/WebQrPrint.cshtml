@model List<(string Token, byte[] QrCode)>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>QR Codes - @ViewBag.TestName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .qr-item {
            width: 180px;
            border: 1px dashed #ccc;
            padding: 10px;
            margin: 5px;
            text-align: center;
            page-break-inside: avoid;
            display: inline-block;
        }
        .qr-img {
            width: 120px;
            height: 120px;
        }
        body { padding-top: 60px; }
        @@media print {
            .no-print { display: none !important; }
            .qr-item { border: 1px solid #000; margin: 10px; }
            body { padding-top: 0; }
        }
    </style>
</head>
<body>
    <div class="d-flex flex-wrap">
        @foreach (var item in Model)
        {
            <div class="qr-item">
                <img src="data:image/png;base64,@Convert.ToBase64String(item.QrCode)" class="qr-img" />
                <div class="mt-2 text-muted small user-select-all">@item.Token.Substring(0, 8)...</div>
            </div>
        }
    </div>
    
    <div class="fixed-top p-2 no-print bg-white border-bottom">
        <button onclick="window.print()" class="btn btn-primary">Распечатать</button>
        <button onclick="window.history.back()" class="btn btn-secondary">Назад</button>
        <span class="ms-3 text-muted">@ViewBag.TestName (Все неиспользованные коды: @Model.Count)</span>
    </div>
</body>
</html>
