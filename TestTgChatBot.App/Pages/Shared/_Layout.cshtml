<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <title>Admin • QuestTgChatBot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
    <div class="container d-flex justify-content-between">
        <a class="navbar-brand" href="@Url.Action("Index", "Tests", new { area = "Admin" })">Админка</a>

        <form class="d-inline" method="post" action="@Url.ActionLink("Logout", "Auth", new { area = "Auth" }))">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-light btn-sm">Выйти</button>
        </form>
    </div>
</nav>
<div class="container">
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</div>

<!-- перед закрывающим </body> -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script
    src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

<div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index:1080">
    <div id="copyToast" class="toast align-items-center text-white bg-success border-0" role="alert"
         aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">Ссылка скопирована</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
    </div>
</div>
<script>
    document.addEventListener('click', async (e) => {
        const a = e.target.closest('.copy-link');
        if (!a) return;
        e.preventDefault();

        const link = a.dataset.link || a.getAttribute('href') || '';
        try {
            await navigator.clipboard.writeText(link);
            showCopyToast('Ссылка скопирована');
        } catch (ex) {
            console.log(ex);
            alert('Не удалось скопировать ссылку');
        }
    });

    function showCopyToast(msg) {
        const el = document.getElementById('copyToast');
        if (!el) return;
        el.querySelector('.toast-body').textContent = msg;
        const t = bootstrap.Toast.getOrCreateInstance(el, {delay: 1500});
        t.show();
    }
</script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>